{
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/icons/現金管理計算工具-icon-32.png"
    }
  ],
  "headers": [
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

